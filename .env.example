APP_NAME="Ecommerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos (coincide con docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce_user
DB_PASSWORD=ecommerce_password
DB_ROOT_PASSWORD=root_password

# Si es "true", el contenedor ejecuta los seeders automáticamente al arrancar
DB_SEED=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- JWT (tymon/jwt-auth) ---
# Generar con: docker compose exec app php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- Stripe ---
# Obtener claves en https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=
# Obtener al crear el webhook en https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Swagger ---
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_USE_ABSOLUTE_PATH=true

CORS_ALLOWED_ORIGINS=*
